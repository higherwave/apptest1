{
  "name": "signal-flow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test:api": "tsx --test server/*.test.ts",
    "test": "npm run test:api && npm run test:db",
    "test:db": "npm --prefix db test",
    "validate:pages": "node --experimental-strip-types --no-warnings scripts/validate-pages.mjs",
    "check:all": "npm run typecheck && npm test && npm run validate:pages"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.89.0",
    "@carbon/react": "^1.117.0",
    "@carbon/styles": "^1.116.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "sass": "^1.105.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  }
}
