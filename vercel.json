{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/((?!assets/|favicon.svg|privacy.html|about.html).*)",
      "destination": "/index.html"
    }
  ]
}
