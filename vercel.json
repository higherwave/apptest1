{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/((?!assets/|favicon|apple-touch-icon.png|logo.png|robots.txt|privacy.html|about.html|landing.html|app.html).*)",
      "destination": "/app.html"
    }
  ]
}
