{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/((?!assets/|fonts/|favicon|apple-touch-icon.png|logo.png|robots.txt|privacy.html|about.html|landing|app.html).*)",
      "destination": "/app.html"
    }
  ]
}
